    "documentos diferentes": 2,
    "urge mejorar": 2,
    "sin solucion": 2,
    "salio incompleto": 2

}


def clasificar_sentimiento(texto):

    texto_normalizado = normalizar(texto)

    puntos_positivos = 0
    puntos_negativos = 0


    # Analizar frases positivas
    for frase, peso in frases_positivas.items():

        if normalizar(frase) in texto_normalizado:

            puntos_positivos += peso


    # Analizar frases negativas
    for frase, peso in frases_negativas.items():

        if normalizar(frase) in texto_normalizado:

            puntos_negativos += peso


    # Analizar palabras
    palabras_texto = re.findall(
        r"[a-záéíóúüñ]+",
        str(texto).lower()
    )


    for palabra in palabras_texto:

        palabra = normalizar(palabra)

        if palabra in positivas:

            puntos_positivos += 1

        if palabra in negativas:

            puntos_negativos += 1


    # Resultado
    if puntos_positivos > puntos_negativos:

        return "positivo"

    elif puntos_negativos > puntos_positivos:

        return "negativo"

    else:

        return "neutral"


