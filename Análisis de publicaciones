# Función de limpieza de texto
def limpiar_texto(texto):

    if pd.isna(texto):
        return ""

    texto = str(texto).lower()

    # Eliminar URLs
    texto = re.sub(
        r"http\S+|www\S+",
        "",
        texto
    )

    # Eliminar menciones
    texto = re.sub(
        r"@\w+",
        "",
        texto
    )

    # Eliminar hashtags del texto
    texto = re.sub(
        r"#\w+",
        "",
        texto
    )

    # Eliminar números
    texto = re.sub(
        r"\d+",
        "",
        texto
    )

    # Eliminar caracteres especiales
    texto = re.sub(
        r"[^\w\sáéíóúüñ]",
        " ",
        texto
    )

    # Eliminar espacios repetidos
    texto = re.sub(
        r"\s+",
        " ",
        texto
    )

    return texto.strip()


