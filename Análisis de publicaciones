# Normalización de acentos
def normalizar(texto):

    texto = str(texto).lower()

    return "".join(
        c
        for c in unicodedata.normalize(
            "NFD",
            texto
        )
        if unicodedata.category(c) != "Mn"
    )


positivas = {
    normalizar(x)
    for x in positivas
}

negativas = {
    normalizar(x)
    for x in negativas
}


