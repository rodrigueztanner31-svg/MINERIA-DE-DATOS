# Normalización de acentos
def normalizar(texto):

    texto = str(texto).lower()

    return "".join(
        c
        for c in unicodedata.normalize(
            "NFD",
            texto
        )
        if unicodedata.category(c) != "Mn"
    )


positivas = {
    normalizar(x)
    for x in positivas
}

negativas = {
    normalizar(x)
    for x in negativas
}


# Frases positivas
frases_positivas = {

    "por fin": 2,
    "me gusto": 2,
    "muy buena": 2,
